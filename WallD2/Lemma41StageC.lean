/-
  Stage C: the spine node S closed (2026-10-13). The order-2
  derivation of x1bar in G = P/K, kernel-proved with NO new axioms
  and, notably, WITHOUT the two Stage-B identification axioms: the
  character layer is independent of the perfectness layer.

  Source: "A Counterexample to Wall's D(2) Problem", OpenAI, October
  6 2026, family 321. The paper's detecting character rho sends
  x1 -> -1, a1 -> zeta, x2 -> zeta^2, a2 -> -1, s -> 1. This file
  needs only its SIGN LAYER: rho_bar(x1) = -1, rho_bar(a2) = -1,
  everything else 1. That sign character kills all four relators
  (pure (\-1) * (\-1) = 1 arithmetic, checked by decide), kills
  t1 = x1^2 and t2 = x2^3, hence K = normalClosure {t1, t2} lies in
  ker(rho_bar) (K is generated by them as a NORMAL subgroup and the
  kernel is normal), hence x1 is NOT in K (rho_bar(x1) = -1 ≠ 1).

  The assembly: in G = P/K, x1bar^2 = 1 because t1 = x1^2 ∈ K, and
  x1bar ≠ 1 because x1 ∉ K. Between them, orderOf x1bar = 2.

  Lemma 4.1 (K perfect) is NOT needed for this node: perfectness
  feeds the paper's H_2 assembly elsewhere; the order-2 conclusion
  rests on the character alone. The two stages are independent
  load-bearing siblings of the same spine.

  Conventions: [g, h] = g h g^-1 h^-1 (Lemma41Defs).
-/

import WallD2.Lemma41StageB
import Mathlib.GroupTheory.PresentedGroup

open FreeGroup PresentedGroup QuotientGroup

namespace Lemma41
open Gen

def fuSign : Gen → ℤˣ
  | Gen.x1 => -1
  | Gen.a1 => 1
  | Gen.x2 => 1
  | Gen.a2 => -1
  | Gen.s => 1

theorem lift_fuSign_r1 : FreeGroup.lift fuSign r1 = 1 := by decide
theorem lift_fuSign_r2 : FreeGroup.lift fuSign r2 = 1 := by decide
theorem lift_fuSign_r3 : FreeGroup.lift fuSign r3 = 1 := by decide
theorem lift_fuSign_r4 : FreeGroup.lift fuSign r4 = 1 := by decide

theorem rels_fuSign (r : FreeGroup Gen)
    (hr : r ∈ ({r1, r2, r3, r4} : Set (FreeGroup Gen))) :
    FreeGroup.lift fuSign r = 1 := by
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl | rfl | rfl
  · exact lift_fuSign_r1
  · exact lift_fuSign_r2
  · exact lift_fuSign_r3
  · exact lift_fuSign_r4

def rho : P →* ℤˣ := toGroup rels_fuSign

theorem rho_of (x : Gen) : rho (of x) = fuSign x := toGroup.of rels_fuSign

theorem rho_x1 : rho gX1 = -1 := rho_of x1
theorem rho_a2 : rho gA2 = -1 := rho_of a2
theorem rho_x2 : rho gX2 = 1 := rho_of x2

theorem rho_t1 : rho t1 = 1 := by
  have e : (t1 : P) = (gX1 : P) * gX1 := rfl
  rw [e, _root_.map_mul, rho_x1]
  norm_num

theorem rho_t2 : rho t2 = 1 := by
  have e : (t2 : P) = (gX2 : P) * gX2 * gX2 := rfl
  rw [e, _root_.map_mul, _root_.map_mul, rho_x2]
  norm_num

theorem K_le_ker_rho : K ≤ MonoidHom.ker rho := by
  refine @Subgroup.normalClosure_le_normal P _ {t1, t2} (MonoidHom.ker rho)
    (MonoidHom.normal_ker rho) ?_
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact MonoidHom.mem_ker.2 rho_t1
  · exact MonoidHom.mem_ker.2 rho_t2

theorem x1_not_mem_K : (gX1 : P) ∉ K := by
  intro hmem
  have h1 : rho gX1 = 1 := MonoidHom.mem_ker.1 (K_le_ker_rho hmem)
  rw [rho_x1] at h1
  exact absurd h1 (by decide)

abbrev G : Type := P ⧸ K

instance : K.Normal := K_normal

abbrev x1bar : G := QuotientGroup.mk gX1

theorem x1bar_sq : x1bar ^ 2 = 1 := by
  show QuotientGroup.mk ((gX1 : P) * gX1) = 1
  have e : ((gX1 : P) * gX1) = t1 := rfl
  rw [e]
  exact (QuotientGroup.eq_one_iff _).2 t1_mem_K

theorem x1bar_ne_one : x1bar ≠ 1 := by
  intro h
  have hmem : (gX1 : P) ∈ K := (QuotientGroup.eq_one_iff _).1 h
  exact x1_not_mem_K hmem

theorem x1bar_order : orderOf x1bar = 2 := by
  refine (orderOf_eq_iff (by norm_num)).2 ⟨x1bar_sq, ?_⟩
  intro m hm h0m
  have hm1 : m = 1 := by omega
  rw [hm1, pow_one]
  exact x1bar_ne_one

end Lemma41
